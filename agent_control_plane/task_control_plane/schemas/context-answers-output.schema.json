{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextAnswersOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["answered", "unresolved"]
          },
          "answer": {
            "type": ["string", "null"]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": ["question_id", "status", "answer", "reason"]
      }
    }
  },
  "required": ["answers"]
}
