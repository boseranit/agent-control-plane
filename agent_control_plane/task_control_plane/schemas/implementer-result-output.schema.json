{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImplementerResultOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["implementation_complete"]
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "recommended_commands": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["name", "argv"]
      }
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "required": [
    "status",
    "summary",
    "changed_files",
    "recommended_commands",
    "notes"
  ]
}
