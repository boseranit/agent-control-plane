{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewerOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["approved", "rejected"]
    },
    "summary": {
      "type": "string"
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": ["string", "null"]
          },
          "line": {
            "type": ["integer", "null"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["path", "line", "message"]
      }
    },
    "requested_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": ["string", "null"]
          },
          "line": {
            "type": ["integer", "null"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["path", "line", "message"]
      }
    },
    "non_blocking_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": ["string", "null"]
          },
          "line": {
            "type": ["integer", "null"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["path", "line", "message"]
      }
    }
  },
  "required": [
    "status",
    "summary",
    "blocking_issues",
    "requested_changes",
    "non_blocking_issues"
  ]
}
